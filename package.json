{
  "name": "yt-control",
  "displayName": "YT Control",
  "version": "1.0.0",
  "description": "Remember your YouTube speed and add Bluetooth video sync delay.",
  "author": "Noah Becker",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plasmohq/storage": "1.15.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.1.40",
    "@types/node": "25.6.0",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.8.3",
    "typescript": "6.0.3"
  },
  "manifest": {
    "action": {
      "default_popup": "popup.html",
      "default_title": "YT Control"
    },
    "permissions": [
      "storage"
    ]
  }
}
